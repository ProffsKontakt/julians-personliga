# --- Kvittotolkning + marknadsbriefing (Anthropic) ---
# Utan denna nyckel funkar appen, men /api/receipt/parse och /api/kapital/brief
# svarar 503 och du får mata in kvitton manuellt.
ANTHROPIC_API_KEY=

# Behövs BARA om nyckeln ovan är skapad på organisationsnivå och inte tillhör
# någon workspace. Anthropic avvisar då anropen med 400 och ber om det här
# huvudet. En workspace-scopad nyckel behöver inte variabeln — lämna den tom.
# ID:t hittar du i Anthropic Console under Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=

# --- Kursdata (valfritt) ---
# Om satt hämtar /api/quotes riktiga kurser. Annars matar du in dem för hand.
# Finnhub: https://finnhub.io  (gratis tier räcker för privat bruk)
FINNHUB_API_KEY=
